services:
  agent-service:
    image: ghcr.io/zaibhusan/electra-agent-service:latest
    container_name: electra-agent
    restart: unless-stopped
    ports:
      - "4001:3000"
    env_file:
      - ./backend/agent-service/.env

  app-service:
    image: ghcr.io/zaibhusan/electra-app-service:latest
    container_name: electra-app
    restart: unless-stopped
    ports:
      - "4000:4000"
    env_file:
      - ./backend/app-service/.env

  frontend:
    image: ghcr.io/zaibhusan/electra-frontend:latest
    container_name: electra-frontend
    restart: unless-stopped
    ports:
      - "4002:4002"